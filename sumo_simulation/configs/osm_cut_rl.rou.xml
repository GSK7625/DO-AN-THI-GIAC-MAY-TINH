<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Vehicle type definitions -->
    <!-- jmIgnoreKeepClearTime: after Xs waiting, enter junction even if exit is blocked (-1=always) -->
    <!-- jmDriveAfterYellowTime: allow entering junction for Xs after yellow ends -->
    <vType id="standard_car" accel="2.6" decel="4.5" length="4.5" minGap="2.0" maxSpeed="13.41"
           sigma="0.5" speedFactor="1.0"
           jmIgnoreKeepClearTime="5" jmDriveAfterYellowTime="1.0" jmTimegapMinor="1.0" />
    <vType id="truck" accel="1.0" decel="4.0" length="10.0" minGap="2.5" maxSpeed="10.0"
           sigma="0.3" speedFactor="0.9"
           jmIgnoreKeepClearTime="5" jmDriveAfterYellowTime="1.0" jmTimegapMinor="1.5" />
    <vType id="motorcycle" accel="2.5" decel="5.0" length="2.2" minGap="1.2" maxSpeed="13.41"
           sigma="0.5" speedFactor="1.1"
           jmIgnoreKeepClearTime="3" jmDriveAfterYellowTime="1.0" jmTimegapMinor="0.8" />

    <!-- Route definitions -->
    <route id="N_S" edges="428067750#0 428067754#0" />
    <route id="N_E" edges="428067750#0 378376408#0" />
    <route id="N_W" edges="428067750#0 160183267#0" />
    
    <route id="S_N" edges="-577951513 -428067750#1" />
    <route id="S_E" edges="-577951513 378376408#0" />
    <route id="S_W" edges="-577951513 160183267#0" />
    
    <route id="E_N" edges="428067759#0 -428067750#1" />
    <route id="E_S" edges="428067759#0 428067754#0" />
    <route id="E_W" edges="428067759#0 160183267#0" />
    
    <route id="W_N" edges="428067756.116 -428067750#1" />
    <route id="W_S" edges="428067756.116 428067754#0" />
    <route id="W_E" edges="428067756.116 378376408#0" />

    <!-- East approach: heavy flow -->
    <flow id="flow_E_W" type="standard_car" route="E_W" begin="0" end="1000" vehsPerHour="450" departLane="best" departSpeed="desired" />
    <flow id="flow_E_N" type="standard_car" route="E_N" begin="0" end="1000" vehsPerHour="80"  departLane="best" departSpeed="desired" />
    <flow id="flow_E_S" type="standard_car" route="E_S" begin="0" end="1000" vehsPerHour="80"  departLane="best" departSpeed="desired" />

    <!-- West approach: heavy flow -->
    <flow id="flow_W_E" type="standard_car" route="W_E" begin="0" end="1000" vehsPerHour="450" departLane="best" departSpeed="desired" />
    <flow id="flow_W_N" type="standard_car" route="W_N" begin="0" end="1000" vehsPerHour="80"  departLane="best" departSpeed="desired" />
    <flow id="flow_W_S" type="standard_car" route="W_S" begin="0" end="1000" vehsPerHour="80"  departLane="best" departSpeed="desired" />

    <!-- North approach: medium flow -->
    <flow id="flow_N_S" type="standard_car" route="N_S" begin="0" end="1000" vehsPerHour="220"  departLane="best" departSpeed="desired" />
    <flow id="flow_N_E" type="standard_car" route="N_E" begin="0" end="1000" vehsPerHour="60"  departLane="best" departSpeed="desired" />
    <flow id="flow_N_W" type="standard_car" route="N_W" begin="0" end="1000" vehsPerHour="60"  departLane="best" departSpeed="desired" />

    <!-- South approach: medium flow -->
    <flow id="flow_S_N" type="standard_car" route="S_N" begin="0" end="1000" vehsPerHour="220"  departLane="best" departSpeed="desired" />
    <flow id="flow_S_E" type="standard_car" route="S_E" begin="0" end="1000" vehsPerHour="60"  departLane="best" departSpeed="desired" />
    <flow id="flow_S_W" type="standard_car" route="S_W" begin="0" end="1000" vehsPerHour="60"  departLane="best" departSpeed="desired" />

    <!-- Trucks: slightly increased flow -->
    <flow id="flow_truck_E" type="truck" route="E_W" begin="0" end="1000" vehsPerHour="30" departLane="best" departSpeed="desired" />
    <flow id="flow_truck_W" type="truck" route="W_E" begin="0" end="1000" vehsPerHour="30" departLane="best" departSpeed="desired" />
    <flow id="flow_truck_N" type="truck" route="N_S" begin="0" end="1000" vehsPerHour="20" departLane="best" departSpeed="desired" />
    <flow id="flow_truck_S" type="truck" route="S_N" begin="0" end="1000" vehsPerHour="20" departLane="best" departSpeed="desired" />
</routes>
